# ===========================================
# 복붙: 루트에 .env 로 저장 후 값만 채우기
#   PowerShell: Copy-Item .env.template .env
# ===========================================

# --- Vite 프론트 (npm run dev / build) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 공개 앱 HTTPS 주소. 네이티브 공유 링크와 이메일/OAuth 콜백에 사용합니다.
# 실제 앱 배포 도메인과 Supabase Redirect URLs 설정을 일치시켜 주세요.
VITE_PUBLIC_APP_URL=https://veroro-app.netlify.app

# 관리자 콘솔 허용 이메일(쉼표 구분, 소문자로 비교)
# VITE_ADMIN_EMAILS=veroro@eternalsix.com

# Phase 2 별칭 관찰 모드 (기본 false — 켜지 마세요)
# true 로 켜면 원재료 매칭 결과를 관찰·기록만 합니다. 점수·위험도 판정은 바뀌지 않습니다.
# 운영 중 끄려면 관리자 콘솔 → 시스템 설정에서 재배포 없이 비활성화할 수 있습니다.
VITE_ENABLE_PHASE2_ALIAS_OBSERVATION=false

# 카카오 JavaScript 키 (카카오톡 공유 등 SDK 기능용 — 로그인에는 쓰지 않는다)
# 플랫폼에 웹 도메인(로컬은 http://localhost:5173 등) 등록 후 사용
VITE_KAKAO_JAVASCRIPT_KEY=

# --- 카카오 로그인/회원가입 ---
# 카카오 REST API 키와 Client Secret 은 프론트에 넣지 않는다.
# Supabase 대시보드 → Authentication → Providers → Kakao 에만 입력한다.
#   1. 카카오 개발자 콘솔에서 앱 생성 → REST API 키 / Client Secret 발급
#   2. 카카오 Redirect URI 에 https://<프로젝트>.supabase.co/auth/v1/callback 등록
#   3. Supabase 에서 Kakao 제공자 활성화 + 키 입력
#   4. 아래 값을 true 로 바꾸고 재배포하면 로그인 화면의 카카오 버튼이 열린다.
# 키가 준비되기 전에는 false 로 두어야 버튼이 '준비 중'으로 잠긴다.
VITE_KAKAO_LOGIN_ENABLED=false
# 위 플래그는 웹 전용입니다. 네이티브에서는 Apple 4.8에 맞는 동등한
# 개인정보 보호 로그인 제공자가 구현/검증될 때까지 카카오 로그인을 차단합니다.

# Native scan requests use the HTTPS backend; never put a service key in VITE_*.
VITE_API_BASE_URL=https://veroro-app.netlify.app
# Optional privacy contact; default is the existing company contact.
VITE_PRIVACY_CONTACT_EMAIL=

# --- Supabase Edge Functions (로컬: npx supabase functions serve --env-file .env) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Netlify Functions only: server-side secrets, never VITE_*.
GEMINI_API_KEY=
SCAN_RATE_LIMIT_SECRET=
# Optional additional cross-origin web callers; packaged native origins are allowed.
# SCAN_ALLOWED_ORIGINS=https://your-app.example

# Edge CORS (선택, 쉼표로 여러 도메인)
# CORS_ALLOWED_ORIGINS=https://your-app.netlify.app

# --- 배포 시 ---
# Supabase: Edge Functions → Secrets 에 위 키 이름으로 등록
# Netlify 프론트: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_KAKAO_JAVASCRIPT_KEY(선택),
#                VITE_KAKAO_LOGIN_ENABLED(선택), VITE_ADMIN_EMAILS(선택)
