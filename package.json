{
  "name": "veroro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:purchase-links": "node --experimental-vm-modules --test scripts/purchase-link-contract.test.mjs",
    "test:purchase-links:concurrency": "node --test --test-concurrency=1 scripts/purchase-link-concurrency.test.mjs",
    "test:purchase-links:schema": "node --test scripts/purchase-link-postgres-schema.test.mjs",
    "preview": "vite preview",
    "import:incheon": "node scripts/import-incheon-pet-food.mjs",
    "audit:production-data": "node --use-system-ca scripts/audit-production-data.mjs",
    "typecheck": "tsc -b && npm run typecheck:functions",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "check": "npm run lint && npm test && npm run test:catalog && npm run test:bootstrap && npm run test:schemas && npm run build",
    "native:sync": "npm run build && cap sync",
    "import:official": "node scripts/import-official-catalog.mjs",
    "test:catalog": "node --test scripts/import-official-catalog.test.mjs",
    "db:prepare-local": "node scripts/prepare-local-supabase.mjs",
    "test:bootstrap": "node scripts/validate-local-bootstrap.mjs",
    "test:schemas": "node scripts/test-scan-schema.mjs && node scripts/test-account-schema.mjs && node scripts/test-catalog-schema.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tosspayments/payment-widget-sdk": "^0.12.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.4",
    "@netlify/edge-functions": "^4.0.0",
    "@netlify/functions": "^6.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "iconv-lite": "^0.7.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
